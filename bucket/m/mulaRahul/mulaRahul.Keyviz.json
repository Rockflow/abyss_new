    "homepage": "https://keyviz.org",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/mulaRahul/keyviz/releases/download/v2.1.2/keyviz_2.1.2_windows.msi",
            "hash": "b7f811e7b354d5be6830eba2130d95207ff2638fa4848b7606afd308a6144973"
        }
    },
    "extract_dir": "PFiles\\keyviz",
    "extract_to": "app",
    "shortcuts": [
        [
            "app\\keyviz.exe",
            "keyviz"
        ]
    ],
    "link": "$env:AppData\\org.keyviz",
    "cleanup": "$env:LocalAppData\\org.keyviz",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/mulaRahul/keyviz"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/mulaRahul/keyviz/releases/download/v$version/keyviz_$version_windows.msi"
            }
        }
    }
