{
    "version": "0.21.0",
    "description": "一个还算强大的 Web 思维导图 | A relatively powerful web mind map",
    "homepage": "https://github.com/wanglin2/mind-map",
    "license": {
        "identifier": "Freemium"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/wanglin2/mind-map/releases/download/0.21.0/Setup.0.21.0.exe",
            "hash": "c67fe8330b4bcc74ee23e1aa7be040c1eb8ed72984a6fd2b7b6f437aeda8c8f0"
        }
    },
    "shortcuts": [
        [
            "app\\思绪思维导图.exe",
            "思绪思维导图"
        ]
    ],
    "link": "$env:AppData\\thoughts",
    "cleanup": "$env:LocalAppData\\thoughts-updater",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall 思绪思维导图.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/wanglin2/mind-map"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/wanglin2/mind-map/releases/download/$version/Setup.$version.exe"
            }
        }
    }
}
