    "homepage": "https://music.moekoe.cn",
    "license": {
        "identifier": "GPL-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/iAJue/MoeKoeMusic/releases/download/v1.7.2/MoeKoe_Music_Setup_v1.7.2.exe",
            "hash": "6dac833a99059bac9cb7b01c1af8060d2139c4da36b14bf9f57d5485c53ab6ce"
        }
    },
    "shortcuts": [
        [
            "app\\MoeKoe Music.exe",
            "MoeKoe Music"
        ]
    ],
    "link": "$env:AppData\\moekoemusic",
    "cleanup": "$env:LocalAppData\\moekoemusic-updater",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall MoeKoe Music.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/iAJue/MoeKoeMusic"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/iAJue/MoeKoeMusic/releases/download/v$version/MoeKoe_Music_Setup_v$version.exe"
            }
        }
    }
