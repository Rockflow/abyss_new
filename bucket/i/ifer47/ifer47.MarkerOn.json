{
    "version": "2.14.0",
    "description": "支持点击穿透模式的轻量级开源屏幕标注工具 | Lightweight open-source screen annotation tool with click-through mode",
    "homepage": "https://ifer47.github.io/markeron",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/ifer47/markeron/releases/download/v2.14.0/MarkerOn_2.14.0_x64-setup.exe",
            "hash": "dc4b7a1e459dddf36268ac07f8f934d0dbb88b388fd9e1b376f4e9cfa660af5c"
        }
    },
    "shortcuts": [
        [
            "app\\MarkerOn.exe",
            "MarkerOn"
        ]
    ],
    "link": "$env:AppData\\com.markeron.app",
    "cleanup": "$env:LocalAppData\\com.markeron.app",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/ifer47/markeron"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ifer47/markeron/releases/download/v$version/MarkerOn_$version_x64-setup.exe"
            }
        }
    }
}
