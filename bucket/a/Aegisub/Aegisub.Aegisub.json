{
    "version": "3.5.1",
    "description": "一款免费、跨平台的开源字幕编辑软件 | A free, cross-platform open source tool for creating and modifying subtitles",
    "homepage": "https://www.aegisub.org",
    "license": {
        "identifier": "Unknown"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/TypesettingTools/Aegisub/releases/download/v3.5.1/Aegisub-3.5.1-x64.exe",
            "hash": "a1c6e03f9e3117af36641f70146495b713b9dc821bd77f1a1e3fbf0c7ef13053"
        }
    },
    "shortcuts": [
        [
            "app\\aegisub.exe",
            "Aegisub"
        ]
    ],
    "link": "$env:AppData\\Aegisub",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-Inno"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/TypesettingTools/Aegisub"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/TypesettingTools/Aegisub/releases/download/v$version/Aegisub-$version-x64.exe"
            }
        }
    }
}
