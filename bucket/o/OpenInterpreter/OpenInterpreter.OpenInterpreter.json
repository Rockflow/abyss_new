{
    "version": "0.0.60",
    "description": "专为低成本模型优化的代码智能体 | A coding agent optimized for low-cost models",
    "homepage": "http://openinterpreter.com",
    "license": {
        "identifier": "Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/openinterpreter/openinterpreter/releases/download/rust-v0.0.60/open-interpreter-package-x86_64-pc-windows-msvc.tar.gz",
            "hash": "c18241ea18e45b3b2ac52787cd13119ce07fd6d161953ea4218d9d162692d183"
        },
        "arm64": {
            "url": "https://github.com/openinterpreter/openinterpreter/releases/download/rust-v0.0.60/open-interpreter-package-aarch64-pc-windows-msvc.tar.gz",
            "hash": "678ca56bb2aff2ac0d9bfd2ff68f4340720684d9bb5506dce48a312f5cc1f99c"
        }
    },
    "extract_to": "app",
    "bin": [
        "app\\bin\\i.exe",
        "app\\bin\\interpreter.exe"
    ],
    "link": "$home\\.openinterpreter",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/openinterpreter/openinterpreter",
        "regex": "rust-v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/openinterpreter/openinterpreter/releases/download/rust-v$version/open-interpreter-package-x86_64-pc-windows-msvc.tar.gz"
            },
            "arm64": {
                "url": "https://github.com/openinterpreter/openinterpreter/releases/download/rust-v$version/open-interpreter-package-aarch64-pc-windows-msvc.tar.gz"
            }
        }
    }
}
