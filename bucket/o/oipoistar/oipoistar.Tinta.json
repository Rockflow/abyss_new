{
    "version": "4.0.2",
    "description": "适用于 Windows 的轻量快速 Markdown 与 Mermaid 查看器 | Fast, lightweight markdown and Mermaid viewer for Windows",
    "homepage": "https://tinta.cc",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/oipoistar/tinta/releases/download/v4.0.2/tinta.exe",
            "hash": "b4e7bf9d404fa5eca32f8c2295c5118ba26163e2477fde69289ae88e775a8ec8"
        }
    },
    "extract_to": "app",
    "bin": "app\\tinta.exe",
    "link": "$env:AppData\\Tinta",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "repo": "oipoistar/tinta",
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/oipoistar/tinta/releases/download/v$version/tinta.exe"
            }
        }
    }
}
