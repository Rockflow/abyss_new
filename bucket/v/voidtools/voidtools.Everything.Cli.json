            "hash": "a4e0f429c03f7b768cf777ad25a55c10c1b82ff06d5cae4ac52925b7b19b16ec"
        },
        "arm64": {
            "url": "https://github.com/voidtools/ES/releases/download/1.1.1.40/ES-1.1.1.40.ARM64.zip",
            "hash": "04e8c0de3422ac664d02ee829119e518cd26976ea18f35d96dea3e8195a47e5b"
        }
    },
    "extract_to": "app",
    "bin": "app\\es.exe",
    "link": "$env:AppData\\voidtools\\es",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/voidtools/ES"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/voidtools/ES/releases/download/$version/ES-$version.x64.zip"
            },
            "arm64": {
                "url": "https://github.com/voidtools/ES/releases/download/$version/ES-$version.ARM64.zip"
            }
        }
    }
}
