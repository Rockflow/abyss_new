{
    "version": "5.13.7",
    "description": "适用于 Windows 的高性能本地文件检索与效率启动工具 | High-performance local file search and productivity launcher for Windows",
    "homepage": "https://lertaro.github.io",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.13.7/Lertaro-Setup.exe",
            "hash": "da588336879ae33edfa77091da7b6004b8ab621437a9bb86a43310abd64d3516"
        },
        "arm64": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.13.7/Lertaro-Setup-arm64.exe",
            "hash": "1da57c0c9c5e4bc9a15438ac5838c7a76e9dcf3a8ee31b0f3d3690a2fadb6601"
        }
    },
    "shortcuts": [
        [
            "app\\Lertaro.App.exe",
            "Lertaro"
        ]
    ],
    "link": "$env:LocalAppData\\Lertaro",
    "cleanup": "$env:ProgramData\\Lertaro",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-Inno"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/Lertaro/Lertaro"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Setup.exe"
            },
            "arm64": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Setup-arm64.exe"
            }
        }
    }
}
