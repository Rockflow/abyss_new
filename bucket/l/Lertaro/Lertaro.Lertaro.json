{
    "version": "5.12.9",
    "description": "适用于 Windows 的高性能本地文件检索与效率启动工具 | High-performance local file search and productivity launcher for Windows",
    "homepage": "https://lertaro.github.io",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.12.9/Lertaro-Setup.exe",
            "hash": "80343834e37d576eedb16b0e16f52ab0da7e40ff876e426408146cbecb499a49"
        },
        "arm64": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.12.9/Lertaro-Setup-arm64.exe",
            "hash": "424600fff73565422c5f071ee52677912f46cbc097024dfe129d422300df6a36"
        }
    },
    "shortcuts": [
        [
            "app\\Lertaro.App.exe",
            "Lertaro"
        ]
    ],
    "link": "$env:LocalAppData\\Lertaro",
    "cleanup": "$env:ProgramData\\Lertaro",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-Inno"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/Lertaro/Lertaro"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Setup.exe"
            },
            "arm64": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Setup-arm64.exe"
            }
        }
    }
}
