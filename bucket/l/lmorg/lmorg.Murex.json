{
    "version": "7.4.2002",
    "description": "一个更智能、更直观且更易读的 Shell | A smarter, more intuitive, and readable shell",
    "homepage": "https://murex.rocks",
    "license": {
        "identifier": "GPL-2.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://nojs.murex.rocks/bin/latest/murex-windows-amd64.exe.zip",
            "hash": "0eac2e7dae923807e30b28ed9c904ecc9e2e296c7c7c496356252a24ec2f9df1",
            "bin": [
                [
                    "app\\bin\\murex-7.4-windows-amd64.exe",
                    "murex"
                ]
            ]
        }
    },
    "extract_to": "app",
    "link": [
        "$home\\.murex_modules",
        "$home\\.murex_preload",
        "$home\\.murex_profile",
        "$home\\.murex_history"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/lmorg/murex"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://nojs.murex.rocks/bin/latest/murex-windows-amd64.exe.zip",
                "bin": [
                    [
                        "app\\bin\\murex-$majorVersion.$minorVersion-windows-amd64.exe",
                        "murex"
                    ]
                ]
            }
        }
    }
}
