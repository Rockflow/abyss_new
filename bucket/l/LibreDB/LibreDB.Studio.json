{
    "version": "1.3.0",
    "description": "一款基于网页的 SQL 集成开发环境，支持 PostgreSQL、MySQL、SQLite、Oracle、SQL Server、MongoDB 和 Redis，具备 AI 查询辅助功能 | Web-based SQL IDE for PostgreSQL, MySQL, SQLite, Oracle, SQL Server, MongoDB, and Redis with AI query assistance",
    "homepage": "https://libredb.org",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/libredb/libredb-studio/releases/download/1.3.0/libredb-studio-standalone-1.3.0-win32-x64.zip",
            "hash": "ccffc53b7e70b731992f1a8dedb7cf386561efab4e2ae3f9e9221779aecc8a8a"
        }
    },
    "extract_to": "app",
    "bin": "app\\libredb-studio.exe",
    "link": "$env:LocalAppData\\LibreDB\\Studio",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/libredb/libredb-studio"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/libredb/libredb-studio/releases/download/$version/libredb-studio-standalone-$version-win32-x64.zip"
            }
        }
    }
}
