{
    "version": "0.6.1",
    "description": "一款采用 Rust 与 GPUI 编写的跨平台轻量级剪贴板管理工具 | Cross-platform, lightweight clipboard manager written in Rust and GPUI",
    "homepage": "https://github.com/StudentWeis/ropy",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/StudentWeis/ropy/releases/download/0.6.1/ropy-x86_64-pc-windows-msvc.zip",
            "hash": "5f2cf436535ba3270cfd4afd9d6c98252271903a0abc5cf762f67d6ea0edc421"
        }
    },
    "extract_to": "app",
    "shortcuts": [
        [
            "app\\ropy.exe",
            "Ropy"
        ]
    ],
    "link": [
        "$env:AppData\\ropy",
        "$env:LocalAppData\\ropy"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "repo": "StudentWeis/ropy",
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/StudentWeis/ropy/releases/download/$version/ropy-x86_64-pc-windows-msvc.zip"
            }
        }
    }
}
