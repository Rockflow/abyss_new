    "homepage": "https://dandavison.github.io/delta",
    "license": {
        "identifier": "MIT"
    },
    "depends": "abyss/jftuga.less",
    "architecture": {
        "64bit": {
            "url": "https://github.com/dandavison/delta/releases/download/0.22.0/delta-0.22.0-x86_64-pc-windows-msvc.zip",
            "hash": "c9e1eb86cceaa4713c47bdeb4ce2476b78ac7f1082dac8b9cb66cad508cbdd5c",
            "extract_dir": "delta-0.22.0-x86_64-pc-windows-msvc"
        }
    },
    "extract_to": "app",
    "bin": "app\\delta.exe",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/dandavison/delta"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/dandavison/delta/releases/download/$version/delta-$version-x86_64-pc-windows-msvc.zip",
                "extract_dir": "delta-$version-x86_64-pc-windows-msvc"
            }
        }
