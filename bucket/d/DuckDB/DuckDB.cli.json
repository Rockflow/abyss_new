{
    "version": "2.0.1",
    "description": "一种用于过程分析的 SQL 数据库管理系统 | An analytical in-process SQL database management system",
    "homepage": "http://www.duckdb.org",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/duckdb/duckdb/releases/download/v2.0.1/duckdb-cli-windows-amd64.tar.gz",
            "hash": "8e40d1e9c53dfd70dd671c1f886506211bd054272e7eed35e8aa979ad7bcc9b7"
        },
        "arm64": {
            "url": "https://github.com/duckdb/duckdb/releases/download/v2.0.1/duckdb-cli-windows-arm64.tar.gz",
            "hash": "7187649c2f9c17a3a555c177a65b98bfda5298bb75bd5302501899146346ea67"
        }
    },
    "extract_to": "app",
    "bin": "app\\duckdb.exe",
    "link": "$home\\.duckdb",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/duckdb/duckdb"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/duckdb/duckdb/releases/download/v$version/duckdb-cli-windows-amd64.tar.gz"
            },
            "arm64": {
                "url": "https://github.com/duckdb/duckdb/releases/download/v$version/duckdb-cli-windows-arm64.tar.gz"
            }
        }
    }
}
