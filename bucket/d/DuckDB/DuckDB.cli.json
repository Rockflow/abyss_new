{
    "version": "2.0.0",
    "description": "一种用于过程分析的 SQL 数据库管理系统 | An analytical in-process SQL database management system",
    "homepage": "http://www.duckdb.org",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/duckdb/duckdb/releases/download/v2.0.0/duckdb-cli-windows-amd64.tar.gz",
            "hash": "91663c2f36c2a334b0e5e639006d8c29c29e013af0c477d80bb931df68870312"
        },
        "arm64": {
            "url": "https://github.com/duckdb/duckdb/releases/download/v2.0.0/duckdb-cli-windows-arm64.tar.gz",
            "hash": "4b5d1e4611debf676a693a8a6896dc29b352a9c3b11b706e7421d1d6082e05fd"
        }
    },
    "extract_to": "app",
    "bin": "app\\duckdb.exe",
    "link": "$home\\.duckdb",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/duckdb/duckdb"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/duckdb/duckdb/releases/download/v$version/duckdb-cli-windows-amd64.tar.gz"
            },
            "arm64": {
                "url": "https://github.com/duckdb/duckdb/releases/download/v$version/duckdb-cli-windows-arm64.tar.gz"
            }
        }
    }
}
