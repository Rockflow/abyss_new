{
    "version": "2.38.2",
    "description": "用于管理当前目录下环境变量的 Shell 扩展 | Shell extension to manage environment variables per current directory",
    "homepage": "https://direnv.net",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
