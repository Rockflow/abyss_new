            "hash": "62a6a16a3473b8e03c2cdc4e2099655bd4284f6da92122b96d78cdce724d4064"
        },
        "arm64": {
            "url": "https://github.com/direnv/direnv/releases/download/v2.38.2/direnv.windows-arm64.exe#/direnv.exe",
            "hash": "d764268f5090ef9fb3b0219c410feaaa00dc514454e47b40d179d207e7190d35"
        }
    },
    "extract_to": "app",
    "env_set": {
        "DIRENV_CONFIG": "$env:AppData\\direnv"
    },
    "bin": "app\\direnv.exe",
    "link": "$env:AppData\\direnv",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/direnv/direnv"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/direnv/direnv/releases/download/v$version/direnv.windows-amd64.exe#/direnv.exe"
            },
