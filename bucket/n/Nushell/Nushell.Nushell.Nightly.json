{
    "version": "0.117.1-nightly.4",
    "description": "一种用 Rust 编写的新型 shell | A new type of shell written in Rust",
    "homepage": "https://www.nushell.sh",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/nushell/nightly/releases/download/0.117.1-nightly.4%2Bfe2b181/nu-0.117.1-nightly.4-x86_64-pc-windows-msvc.zip",
            "hash": "0d44f5e0ca5efedcff57474d78c887db7cd0689b2ae8454bd324881cb8b123c1"
        },
        "arm64": {
            "url": "https://github.com/nushell/nightly/releases/download/0.117.1-nightly.4%2Bfe2b181/nu-0.117.1-nightly.4-aarch64-pc-windows-msvc.zip",
            "hash": "dbdaccf8e209bf6c1266746b256523bc1684ae0163a4288e0bf7a020a98aee34"
        }
    },
    "conflicts": [
        "Nushell.Nushell",
        "Nushell.Nushell.Nightly"
    ],
    "extract_to": "app",
    "bin": "app\\nu.exe",
    "shortcuts": [
        [
            "app\\nu.exe",
            "Nushell",
            "--execute \"cd ~\""
        ]
    ],
    "link": [
        "$env:AppData\\nushell",
        "$env:LocalAppData\\nushell"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "url": "https://github.com/nushell/nightly/releases",
        "regex": "/nightly/releases/tag/([\\w.-]+)%2B(?<hash>[\\w]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nushell/nightly/releases/download/$version%2B$matchHash/nu-$version-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/nushell/nightly/releases/download/$version%2B$matchHash/nu-$version-aarch64-pc-windows-msvc.zip"
            }
        }
    }
}
