{
    "version": "0.117.1-nightly.1",
    "description": "一种用 Rust 编写的新型 shell | A new type of shell written in Rust",
    "homepage": "https://www.nushell.sh",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/nushell/nightly/releases/download/0.117.1-nightly.1%2B7bff3d1/nu-0.117.1-nightly.1-x86_64-pc-windows-msvc.zip",
            "hash": "7878392ae294afec7331951100b3dbdded9023b6b0347b00df4095ad36e44bd3"
        },
        "arm64": {
            "url": "https://github.com/nushell/nightly/releases/download/0.117.1-nightly.1%2B7bff3d1/nu-0.117.1-nightly.1-aarch64-pc-windows-msvc.zip",
            "hash": "049d6c8b2dd58c4c1e473a2323418f67a51f75bcb35069ec93b2308de0be2ddb"
        }
    },
    "conflicts": [
        "Nushell.Nushell",
        "Nushell.Nushell.Nightly"
    ],
    "extract_to": "app",
    "bin": "app\\nu.exe",
    "shortcuts": [
        [
            "app\\nu.exe",
            "Nushell",
            "--execute \"cd ~\""
        ]
    ],
    "link": [
        "$env:AppData\\nushell",
        "$env:LocalAppData\\nushell"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "url": "https://github.com/nushell/nightly/releases",
        "regex": "/nightly/releases/tag/([\\w.-]+)%2B(?<hash>[\\w]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nushell/nightly/releases/download/$version%2B$matchHash/nu-$version-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/nushell/nightly/releases/download/$version%2B$matchHash/nu-$version-aarch64-pc-windows-msvc.zip"
            }
        }
    }
}
