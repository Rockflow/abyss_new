{
    "version": "0.117.1-nightly.2",
    "description": "一种用 Rust 编写的新型 shell | A new type of shell written in Rust",
    "homepage": "https://www.nushell.sh",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/nushell/nightly/releases/download/0.117.1-nightly.2%2Ba3dd8e6/nu-0.117.1-nightly.2-x86_64-pc-windows-msvc.zip",
            "hash": "4f8975e3fffb11ba82347f93670e39520897e0fbd497766cf3296e4d7de23473"
        },
        "arm64": {
            "url": "https://github.com/nushell/nightly/releases/download/0.117.1-nightly.2%2Ba3dd8e6/nu-0.117.1-nightly.2-aarch64-pc-windows-msvc.zip",
            "hash": "d32b5fabb8cfff17ae611cfe766c1e61c4c0c7696e312c5ec21154ecee2a78fb"
        }
    },
    "conflicts": [
        "Nushell.Nushell",
        "Nushell.Nushell.Nightly"
    ],
    "extract_to": "app",
    "bin": "app\\nu.exe",
    "shortcuts": [
        [
            "app\\nu.exe",
            "Nushell",
            "--execute \"cd ~\""
        ]
    ],
    "link": [
        "$env:AppData\\nushell",
        "$env:LocalAppData\\nushell"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "url": "https://github.com/nushell/nightly/releases",
        "regex": "/nightly/releases/tag/([\\w.-]+)%2B(?<hash>[\\w]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nushell/nightly/releases/download/$version%2B$matchHash/nu-$version-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/nushell/nightly/releases/download/$version%2B$matchHash/nu-$version-aarch64-pc-windows-msvc.zip"
            }
        }
    }
}
