{
    "version": "0.117.1-nightly.7",
    "description": "一种用 Rust 编写的新型 shell | A new type of shell written in Rust",
    "homepage": "https://www.nushell.sh",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/nushell/nightly/releases/download/0.117.1-nightly.7%2B16817a8/nu-0.117.1-nightly.7-x86_64-pc-windows-msvc.zip",
            "hash": "fb8d470753a6eb0724af9c743931a93a02662518f9033baf17faff919cda9206"
        },
        "arm64": {
            "url": "https://github.com/nushell/nightly/releases/download/0.117.1-nightly.7%2B16817a8/nu-0.117.1-nightly.7-aarch64-pc-windows-msvc.zip",
            "hash": "f63b1332b0ec166b36263f228a390a58757bab0561a2ee0b2e9c0f2c49109d4a"
        }
    },
    "conflicts": [
        "Nushell.Nushell",
        "Nushell.Nushell.Nightly"
    ],
    "extract_to": "app",
    "bin": "app\\nu.exe",
    "shortcuts": [
        [
            "app\\nu.exe",
            "Nushell",
            "--execute \"cd ~\""
        ]
    ],
    "link": [
        "$env:AppData\\nushell",
        "$env:LocalAppData\\nushell"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "url": "https://github.com/nushell/nightly/releases",
        "regex": "/nightly/releases/tag/([\\w.-]+)%2B(?<hash>[\\w]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nushell/nightly/releases/download/$version%2B$matchHash/nu-$version-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/nushell/nightly/releases/download/$version%2B$matchHash/nu-$version-aarch64-pc-windows-msvc.zip"
            }
        }
    }
}
