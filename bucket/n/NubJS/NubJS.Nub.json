{
    "version": "0.11.1",
    "description": "功能全面的 JavaScript 工具包，旨在增强 Node.js 的功能，而不是试图取代它 | The all-in-one JavaScript toolkit that augments Node.js instead of trying to replace it",
    "homepage": "https://nubjs.com",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/nubjs/nub/releases/download/v0.11.1/nub-win32-x64.zip",
            "hash": "f78e2baed44b4be35068382a5d9a2cdb54d22c2fd8095058721826df9675ce08"
        },
        "arm64": {
            "url": "https://github.com/nubjs/nub/releases/download/v0.11.1/nub-win32-arm64.zip",
            "hash": "3ac7d9548fd8b82ca0f6997ab743a969f7ac061392af3bf914b95f1af3ef7b53"
        }
    },
    "extract_to": "app",
    "bin": [
        "app\\bin\\nub.exe",
        "app\\bin\\nubx.exe"
    ],
    "link": "$home\\.nub",
    "cleanup": "$home\\.cache\\nub",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "if (!(Test-Path $dir\\app\\bin\\nubx.exe)) { Copy-Item $dir\\app\\bin\\nub.exe $dir\\app\\bin\\nubx.exe }"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/nubjs/nub"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nubjs/nub/releases/download/v$version/nub-win32-x64.zip"
            },
            "arm64": {
                "url": "https://github.com/nubjs/nub/releases/download/v$version/nub-win32-arm64.zip"
            }
        }
    }
}
