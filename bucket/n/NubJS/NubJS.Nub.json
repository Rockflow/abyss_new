{
    "version": "0.11.0",
    "description": "功能全面的 JavaScript 工具包，旨在增强 Node.js 的功能，而不是试图取代它 | The all-in-one JavaScript toolkit that augments Node.js instead of trying to replace it",
    "homepage": "https://nubjs.com",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/nubjs/nub/releases/download/v0.11.0/nub-win32-x64.zip",
            "hash": "14e428c144cb6728287cedee5cd5e5a2b0c359a2fbe2eb0bbc5db5c266d9cee1"
        },
        "arm64": {
            "url": "https://github.com/nubjs/nub/releases/download/v0.11.0/nub-win32-arm64.zip",
            "hash": "a859623fc5f359efa9a7dc19f225fac7f5f2fe253b6a8101054108d83c4cc742"
        }
    },
    "extract_to": "app",
    "bin": [
        "app\\bin\\nub.exe",
        "app\\bin\\nubx.exe"
    ],
    "link": "$home\\.nub",
    "cleanup": "$home\\.cache\\nub",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "if (!(Test-Path $dir\\app\\bin\\nubx.exe)) { Copy-Item $dir\\app\\bin\\nub.exe $dir\\app\\bin\\nubx.exe }"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/nubjs/nub"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nubjs/nub/releases/download/v$version/nub-win32-x64.zip"
            },
            "arm64": {
                "url": "https://github.com/nubjs/nub/releases/download/v$version/nub-win32-arm64.zip"
            }
        }
    }
}
