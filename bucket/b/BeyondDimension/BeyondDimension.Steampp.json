{
    "version": "3.2.0",
    "description": "一个开源跨平台的多功能 Steam 工具箱，包含 GitHub 网络加速等功能，Watt Toolkit 是它的别名 | A toolbox with lots of Steam tools. Another name for it is: Watt Toolkit",
    "homepage": "https://steampp.net",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/BeyondDimension/SteamTools/releases/download/3.2.0/Steam++_v3.2.0_win_x64.7z",
            "hash": "a48cbbf7e58c92fd8c82514ff968766d85da882743a90ef8aaed1312e8ed4404"
        }
    },
    "extract_to": "app",
    "bin": "app\\Steam++.exe",
    "shortcuts": [
        [
            "app\\Steam++.exe",
            "Steam++"
        ]
    ],
    "persist": [
        [
            "app\\AppData",
            "AppData\\Local\\Steam++"
        ]
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/BeyondDimension/SteamTools"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/BeyondDimension/SteamTools/releases/download/$version/Steam++_v$version_win_x64.7z"
            }
        }
    }
}
