{
    "version": "8.4.7",
    "description": "飞书，字节跳动下先进企业协作与管理平台 | Feishu is a cloud-based enterprise collaboration and management platform developed by ByteDance",
    "homepage": "https://www.feishu.cn",
    "license": {
        "identifier": "Freemium"
    },
    "architecture": {
        "64bit": {
            "url": "https://sf3-cn.feishucdn.com/obj/ee-appcenter/9b9ebe96/Feishu-win32_ia32-8.4.7-signed.exe",
            "hash": "17151147cbab72277a2e49dc2273a02d208e8a56f78e2aa8b3750816be47615c"
        }
    },
    "shortcuts": [
        [
            "app\\Feishu\\Feishu.exe",
            "飞书"
        ]
    ],
    "link": "$env:AppData\\LarkShell",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "$InstallDir = '\"' + \"$dir\\app\" + '\"'",
        "$LogDir = '\"' + \"$env:TEMP\\Scoop_${app}@${version}_logs\" + '\"'",
        "A-Install-App -ArgumentList '--command=quiet_install', \"--target_dir=$InstallDir\", \"--log_dir=$LogDir\"",
        "A-Hold-App"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Uninstall-Manually 'app'",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX86",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x86_user.InstallerSha256"
                }
            }
        }
    }
}
