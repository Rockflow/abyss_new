{
    "version": "3.0.1",
    "description": "一款方便查看指定目录磁盘空间占用情况的工具 | A tool to conveniently learn about the usage of disk space of a given directory",
    "homepage": "https://github.com/Byron/dua-cli",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Byron/dua-cli/releases/download/v3.0.1/dua-v3.0.1-x86_64-pc-windows-msvc.zip",
            "hash": "ff9064f1b0af51eeacaaa63a97c3628e670117a8f336710ee54fe96f54193b9d",
            "extract_dir": "dua-v3.0.1-x86_64-pc-windows-msvc"
        },
        "arm64": {
            "url": "https://github.com/Byron/dua-cli/releases/download/v3.0.1/dua-v3.0.1-aarch64-pc-windows-msvc.zip",
            "hash": "e1fd8f8c75eb425f56683ce6c0b224b1f639b57e1e1f2238f1b3232276389213",
            "extract_dir": "dua-v3.0.1-aarch64-pc-windows-msvc"
        }
    },
    "extract_to": "app",
    "bin": "app\\dua.exe",
    "link": "$env:AppData\\dua-cli",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/Byron/dua-cli"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Byron/dua-cli/releases/download/v$version/dua-v$version-x86_64-pc-windows-msvc.zip",
                "extract_dir": "dua-v$version-x86_64-pc-windows-msvc"
            },
            "arm64": {
                "url": "https://github.com/Byron/dua-cli/releases/download/v$version/dua-v$version-aarch64-pc-windows-msvc.zip",
                "extract_dir": "dua-v$version-aarch64-pc-windows-msvc"
            }
        }
    }
}
