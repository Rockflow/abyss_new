{
    "version": "0.52.1.1",
    "description": "一个原生运行人工智能代理的开源 Chromium 浏览器分支 | An open-source chromium browser fork that runs AI agents natively",
    "homepage": "https://browseros.com",
    "license": {
        "identifier": "AGPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/browseros-ai/BrowserOS/releases/download/browserclaw%2Fv0.52.0/BrowserOS_neo_v0.52.1.1_x64_installer.exe",
            "hash": "f9a8493dd8cbcf11b349ff41e434f5d67c301d99613ccc221f418385e361f2cd"
        }
    },
    "location": "$env:ProgramFiles\\Chromium\\Application",
    "link": [
        "$env:LocalAppData\\BrowserOS\\BrowserOS\\User Data",
        "$home\\.browseros"
    ],
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -ArgumentList '--do-not-launch-chrome','--system-level'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "$Uninstaller = Get-ChildItem \"$env:ProgramFiles\\Chromium\\Application\" setup.exe -Recurse | Sort-Object LastWriteTime -Descending | Select-Object -First 1",
        "A-Uninstall-App -Uninstaller $Uninstaller.FullName -ArgumentList '--uninstall','--system-level','--multi-install','--force-uninstall'",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/browseros-ai/BrowserOS",
        "script": "(($page | ConvertFrom-Json).assets | Where-Object { $_.name -match '^BrowserOS_neo_v[\\d.]+_x64_installer\\.exe$' })[0].browser_download_url",
        "regex": "browserclaw(?:%2F|/)v(?<tag>[\\d.]+)/BrowserOS_neo_v(?<version>[\\d.]+)_x64_installer\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/browseros-ai/BrowserOS/releases/download/browserclaw%2Fv$matchTag/BrowserOS_neo_v$version_x64_installer.exe"
            }
        }
    }
}
