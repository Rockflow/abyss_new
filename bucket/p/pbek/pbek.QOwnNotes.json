{
    "version": "26.11.6",
    "description": "一款支持 Markdown 格式且能与 Nextcloud / ownCloud 集成的纯文本文件记事本和待办事项管理器 | A plain-text file notepad and todo-list manager with Markdown support and Nextcloud / ownCloud integration",
    "homepage": "https://www.qownnotes.org",
    "license": {
        "identifier": "GPL-2.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/pbek/QOwnNotes/releases/download/v26.11.6/QOwnNotes.zip",
            "hash": "1a6391d0382a7f7771d1d54c77c732b3c031fe0c8a153fbb53d864090cb83e6d"
        }
    },
    "extract_to": "app",
    "shortcuts": [
        [
            "app\\QOwnNotes.exe",
            "QOwnNotes",
            "--portable"
        ]
    ],
    "persist": [
        [
            "app\\Data",
            "AppData\\Roaming\\PBE\\QOwnNotes"
        ],
        [
            "app\\Data\\Notes",
            "Notes"
        ]
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/pbek/QOwnNotes"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/pbek/QOwnNotes/releases/download/v$version/QOwnNotes.zip"
            }
        }
    }
}
