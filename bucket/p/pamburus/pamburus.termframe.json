            "hash": "9f8d17761ac9b598c86137edfa45d64ba41bdedfc790500b7359e81b794db487"
        },
        "arm64": {
            "url": "https://github.com/pamburus/termframe/releases/download/v0.10.1/termframe-windows-arm64.zip",
            "hash": "1911376c71dd5c8a8e5f33f79216e62d91e80d215a4666cf4e0031e1228d4f4f"
        }
    },
    "extract_to": "app",
    "bin": "app\\termframe.exe",
    "link": "$env:AppData\\termframe",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/pamburus/termframe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/pamburus/termframe/releases/download/v$version/termframe-windows.zip"
            },
            "arm64": {
                "url": "https://github.com/pamburus/termframe/releases/download/v$version/termframe-windows-arm64.zip"
