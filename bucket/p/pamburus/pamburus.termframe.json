{
    "version": "0.10.3",
    "description": "一个非交互式终端模拟器，它能执行单个命令，在内部虚拟会话中渲染其输出，并将屏幕截图导出为 SVG 文件 | A non-interactive terminal emulator that executes a single command, renders its output in an internal virtual session, and exports a screenshot as an SVG file",
    "homepage": "https://github.com/pamburus/termframe",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/pamburus/termframe/releases/download/v0.10.3/termframe-windows.zip",
            "hash": "4e1e78294b9bfa8aeaffcbbaef94a380f65e20a149a603f84259152a03c90f07"
        },
        "arm64": {
            "url": "https://github.com/pamburus/termframe/releases/download/v0.10.3/termframe-windows-arm64.zip",
            "hash": "099cb7779dc55a3351df6d888f28e63b0c6bf4d94ae0d97c923dfaf1c68fc766"
        }
    },
    "extract_to": "app",
    "bin": "app\\termframe.exe",
    "link": "$env:AppData\\termframe",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/pamburus/termframe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/pamburus/termframe/releases/download/v$version/termframe-windows.zip"
            },
            "arm64": {
                "url": "https://github.com/pamburus/termframe/releases/download/v$version/termframe-windows-arm64.zip"
            }
        }
    }
