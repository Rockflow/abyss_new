{
    "version": "1.3.4+84",
    "description": "一个 Flutter LLM 聊天客户端 | A Flutter LLM Chat Client",
    "homepage": "https://kelivo.psycheas.top",
    "license": {
        "identifier": "AGPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Chevey339/kelivo/releases/download/v1.3.4/Kelivo_windows_1.3.4+84_setup.exe",
            "hash": "e6eafee16f22e99758cd01ce3eb9a56dc2e12a43eccb30db14aaa79bb4b81f6a"
        }
    },
    "shortcuts": [
        [
            "app\\kelivo.exe",
            "Kelivo"
        ]
    ],
    "link": [
        "$env:AppData\\com.psyche\\kelivo",
        "$env:LocalAppData\\com.psyche\\kelivo"
    ],
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-Inno"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchX64",
                "hash": {
                    "url": "_.json",
                    "jsonpath": "$.x64_machine.InstallerSha256"
                }
            }
        }
    }
}
