{
    "version": "3.2.0",
    "description": "可将网页应用整合为一体且功能丰富的工具 | Tool for organizing web apps into one application with rich features",
    "homepage": "https://rambox.app",
    "license": {
        "identifier": "Proprietary"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/ramboxapp/download/releases/download/v3.2.0/Rambox-3.2.0-win-x64.exe",
            "hash": "d1e704dc6430615fb0b24c137795066edcb96314b7a1924337b62055776d9695"
        }
    },
    "shortcuts": [
        [
            "app\\Rambox.exe",
            "Rambox"
        ]
    ],
    "link": "$env:AppData\\rambox",
    "cleanup": "$env:LocalAppData\\rambox-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall Rambox.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/ramboxapp/download"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ramboxapp/download/releases/download/v$version/Rambox-$version-win-x64.exe"
            }
        }
    }
}
