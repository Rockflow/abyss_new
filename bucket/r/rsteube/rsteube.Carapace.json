{
    "version": "1.8.2",
    "description": "多 shell、多命令、参数补全器 | multi-shell, multi-command, argument completer",
    "homepage": "https://carapace.sh",
    "license": {
        "identifier": "MIT"
    },
    "notes_cn": [
        "安装完成后，需要根据不同 Shell 手动注册补全器。",
        "具体操作请参考：https://carapace-sh.github.io/carapace-bin/setup.html"
    ],
    "notes": [
        "After installation, you need to manually register the completer according to different shells.",
        "Refer to: https://carapace-sh.github.io/carapace-bin/setup.html"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/carapace-sh/carapace-bin/releases/download/v1.8.2/carapace-bin_1.8.2_windows_amd64.zip",
            "hash": "44ac5d1f16bf38df559259783680925fe9625e467e020b180ea1e8d7c721d4e5"
        },
        "arm64": {
            "url": "https://github.com/carapace-sh/carapace-bin/releases/download/v1.8.2/carapace-bin_1.8.2_windows_arm64.zip",
            "hash": "67319d3951317ed46a6a44f4fee2e19f0ddfc31dfcb0b8fc4329d12d18d7869c"
        }
    },
    "conflicts": [
        "rsteube.Carapace",
        "rsteube.Carapace.nightly"
    ],
    "extract_to": "app",
    "env_set": {
        "CARAPACE_TOOLTIP": "1"
    },
    "bin": "app\\carapace.exe",
    "link": [
        "$env:AppData\\carapace",
        "$env:LocalAppData\\carapace"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "repo": "carapace-sh/carapace-bin",
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/carapace-sh/carapace-bin/releases/download/v$version/carapace-bin_$version_windows_amd64.zip"
            },
            "arm64": {
                "url": "https://github.com/carapace-sh/carapace-bin/releases/download/v$version/carapace-bin_$version_windows_arm64.zip"
            }
        }
    }
}
