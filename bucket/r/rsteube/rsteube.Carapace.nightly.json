{
    "version": "2026-11-11",
    "description": "多 shell、多命令、参数补全器 | multi-shell, multi-command, argument completer",
    "homepage": "https://carapace.sh",
    "license": {
        "identifier": "MIT"
    },
    "notes_cn": [
        "安装完成后，需要根据不同 Shell 手动注册补全器。",
        "具体操作请参考：https://carapace-sh.github.io/carapace-bin/setup.html"
    ],
    "notes": [
        "After installation, you need to manually register the completer according to different shells.",
        "Refer to: https://carapace-sh.github.io/carapace-bin/setup.html"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/carapace-sh/nightly/releases/download/2026-11-11/carapace-bin_1.8.2-SNAPSHOT-50f6b15fb_windows_amd64.zip",
            "hash": "24a1ed08f145d4f6827e84485982385ebf0e7549e4245f1ad4b694319d0c975a"
        },
        "arm64": {
            "url": "https://github.com/carapace-sh/nightly/releases/download/2026-11-11/carapace-bin_1.8.2-SNAPSHOT-50f6b15fb_windows_arm64.zip",
            "hash": "918703322ddaaf45afe66c4e1447ad531bfbb7fc05426dff153f62d0f3b0f088"
        }
    },
    "conflicts": [
        "rsteube.Carapace",
        "rsteube.Carapace.nightly"
    ],
    "extract_to": "app",
    "env_set": {
        "CARAPACE_TOOLTIP": "1"
    },
    "bin": "app\\carapace.exe",
    "link": [
        "$env:AppData\\carapace",
        "$env:LocalAppData\\carapace"
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/carapace-sh/nightly",
        "script": "(($page | ConvertFrom-Json).assets | Where-Object { $_.name -match 'carapace-bin_.*_windows_amd64\\.zip$' })[0].browser_download_url",
        "regex": "download/(?<version>[\\d-]+)/carapace-bin_(?<ver>[\\d.]+)-SNAPSHOT-(?<hash>[a-f0-9]+)_windows_amd64\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/carapace-sh/nightly/releases/download/$version/carapace-bin_$matchVer-SNAPSHOT-$matchHash_windows_amd64.zip"
            },
            "arm64": {
                "url": "https://github.com/carapace-sh/nightly/releases/download/$version/carapace-bin_$matchVer-SNAPSHOT-$matchHash_windows_arm64.zip"
            }
        }
    }
}
