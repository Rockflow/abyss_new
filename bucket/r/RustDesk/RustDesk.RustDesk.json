{
    "version": "1.5.1",
    "description": "一个安全的远程桌面访问工具，用 Rust 语言编写 | An open-source remote desktop software, written in Rust",
    "homepage": "https://github.com/rustdesk/rustdesk",
    "license": {
        "identifier": "AGPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/rustdesk/rustdesk/releases/download/1.5.1/rustdesk-1.5.1-x86_64.exe#/rustdesk.exe",
            "hash": "319206042390ebfcba934cf0baa2f612f34de463c78c843b7cb8c22097c4bf7b",
            "bin": [
                [
                    "app\\rustdesk.exe",
                    "rustdesk"
                ]
            ],
            "shortcuts": [
                [
                    "app\\rustdesk.exe",
                    "RustDesk"
                ]
            ]
        }
    },
    "extract_to": "app",
    "link": "$env:AppData\\RustDesk",
    "cleanup": "$env:LocalAppData\\rustdesk",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process \"$env:LocalAppData\\rustdesk\"",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "repo": "rustdesk/rustdesk",
            "channel": "latest"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/rustdesk/rustdesk/releases/download/$version/rustdesk-$version-x86_64.exe#/rustdesk.exe"
            }
        }
    }
}
