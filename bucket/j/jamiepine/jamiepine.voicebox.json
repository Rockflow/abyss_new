{
    "version": "0.6.0",
    "description": "基于 Qwen3-TTS 的开源语音合成平台 | The open-source voice synthesis studio powered by Qwen3-TTS",
    "homepage": "https://voicebox.sh",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/jamiepine/voicebox/releases/download/v0.6.0/Voicebox_0.6.0_x64-setup.exe",
            "hash": "94cc2cffa7f76f8b6cbbc6a4fbdbfbf3d82e9f7ef6add0e21b60f47039d02bca"
        }
    },
    "shortcuts": [
        [
            "app\\voicebox.exe",
            "Voicebox"
        ]
    ],
    "link": "$env:AppData\\sh.voicebox.app",
    "cleanup": "$env:LocalAppData\\sh.voicebox.app",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/jamiepine/voicebox"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/jamiepine/voicebox/releases/download/v$version/Voicebox_$version_x64-setup.exe"
            }
        }
    }
}
