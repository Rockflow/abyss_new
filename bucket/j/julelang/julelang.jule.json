{
    "version": "0.3.0",
    "description": "一种高效的编程语言，能够用于构建高效、快速、可靠且安全的软件，同时保持简洁性 | An effective programming language to build efficient, fast, reliable and safe software while maintaining simplicity",
    "homepage": "https://jule.dev",
    "license": {
        "identifier": "BSD-3-Clause"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/julelang/jule/releases/download/jule0.3.0/jule0.3.0-windows-amd64.zip",
            "hash": "31e4e23bb7cfd85ca0c90b2d6442f698531bb64cba49c73f2f0234f5f606a716"
        },
        "arm64": {
            "url": "https://github.com/julelang/jule/releases/download/jule0.3.0/jule0.3.0-windows-arm64.zip",
            "hash": "c71ce3882b361603deff08bac036dd34b0c50bf063f648556a6b3427240cbee0"
        }
    },
    "extract_dir": "jule",
    "extract_to": "app",
    "env_add_path": "app\\bin",
    "commands": "julec",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": {
            "channel": "latest",
            "repo": "julelang/jule"
        },
        "regex": "jule(.+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/julelang/jule/releases/download/jule$version/jule$version-windows-amd64.zip"
            },
            "arm64": {
                "url": "https://github.com/julelang/jule/releases/download/jule$version/jule$version-windows-arm64.zip"
            }
        }
    }
}
