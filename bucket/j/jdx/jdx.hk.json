    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/jdx/hk/releases/download/v2.11.1/hk-x86_64-pc-windows-msvc.zip",
            "hash": "60b925d9734cd6bec5fab78b9c825b39b2ad9b1c9d9f03b685423c2d21ae9a8c"
        },
        "arm64": {
            "url": "https://github.com/jdx/hk/releases/download/v2.11.1/hk-aarch64-pc-windows-msvc.zip",
