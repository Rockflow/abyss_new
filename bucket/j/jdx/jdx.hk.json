            "hash": "750e1ccaca97b4c33f9b709e4beea9da5de98c7bb3f175cbbe59c05b5a6e365b"
        },
        "arm64": {
            "url": "https://github.com/jdx/hk/releases/download/v2.14.0/hk-aarch64-pc-windows-msvc.zip",
