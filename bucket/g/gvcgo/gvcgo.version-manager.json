{
    "version": "0.8.4",
    "description": "一款通用的版本管理器，适用于数千个 SDK，其终端用户界面（TUI）灵感源自 lazygit | A general version manager for thousands of SDKs with TUI inspired by lazygit",
    "homepage": "http://vdocs.vmr.dpdns.org",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/gvcgo/version-manager/releases/download/v0.8.4/vmr-x86_64-pc-windows-msvc.zip",
            "hash": "1249b142e6d948ebac3bc7e7f87c7c40b75a6284fd4c6a7376adb5e4b81ce25f"
        },
        "arm64": {
            "url": "https://github.com/gvcgo/version-manager/releases/download/v0.8.4/vmr-aarch64-pc-windows-msvc.zip",
            "hash": "17064fdf20bf99c9491d0c995eb0282e11ad3fed211374fd4d35c9cde1125056"
        }
    },
    "extract_to": "app",
    "bin": "app\\vmr.exe",
    "link": "$home\\.vmr",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/gvcgo/version-manager"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/gvcgo/version-manager/releases/download/v$version/vmr-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/gvcgo/version-manager/releases/download/v$version/vmr-aarch64-pc-windows-msvc.zip"
            }
        }
    }
}
