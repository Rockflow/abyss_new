{
    "version": "0.8.1",
    "description": "一款通用的版本管理器，适用于数千个 SDK，其终端用户界面（TUI）灵感源自 lazygit | A general version manager for thousands of SDKs with TUI inspired by lazygit",
    "homepage": "http://vdocs.vmr.dpdns.org",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/gvcgo/version-manager/releases/download/v0.8.1/vmr-x86_64-pc-windows-msvc.zip",
            "hash": "9137835bd9bb9c11d445a850242a266f28f4e6a065ad890cd5f1188e11c82d61"
        },
        "arm64": {
            "url": "https://github.com/gvcgo/version-manager/releases/download/v0.8.1/vmr-aarch64-pc-windows-msvc.zip",
            "hash": "8c321b2299d0c7205f9686a49332ce6c16ef057c0d5cf7691058f8d00423f666"
        }
    },
    "extract_to": "app",
    "bin": "app\\vmr.exe",
    "link": "$home\\.vmr",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/gvcgo/version-manager"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/gvcgo/version-manager/releases/download/v$version/vmr-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/gvcgo/version-manager/releases/download/v$version/vmr-aarch64-pc-windows-msvc.zip"
            }
        }
    }
}
