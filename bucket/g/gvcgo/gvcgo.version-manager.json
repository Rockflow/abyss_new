{
    "version": "0.8.2",
    "description": "一款通用的版本管理器，适用于数千个 SDK，其终端用户界面（TUI）灵感源自 lazygit | A general version manager for thousands of SDKs with TUI inspired by lazygit",
    "homepage": "http://vdocs.vmr.dpdns.org",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/gvcgo/version-manager/releases/download/v0.8.2/vmr-x86_64-pc-windows-msvc.zip",
            "hash": "06e21a31cf6190c830a3f0a35d983839a45636fec1bbd9d4d0187d893c14b523"
        },
        "arm64": {
            "url": "https://github.com/gvcgo/version-manager/releases/download/v0.8.2/vmr-aarch64-pc-windows-msvc.zip",
            "hash": "c6743f05a9cb571fd65184da5dd364492882bf54aa5ecb75b6015e52a54e454f"
        }
    },
    "extract_to": "app",
    "bin": "app\\vmr.exe",
    "link": "$home\\.vmr",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/gvcgo/version-manager"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/gvcgo/version-manager/releases/download/v$version/vmr-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/gvcgo/version-manager/releases/download/v$version/vmr-aarch64-pc-windows-msvc.zip"
            }
        }
    }
}
