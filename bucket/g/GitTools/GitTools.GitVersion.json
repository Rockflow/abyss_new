{
    "version": "7.0.0",
    "description": "一款可依据 Git 提交历史生成语义化版本号的工具 | A tool that generates a Semantic Version number based on your Git history",
    "homepage": "https://gitversion.net",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/GitTools/GitVersion/releases/download/7.0.0/gitversion-win-x64-7.0.0.zip",
            "hash": "13f70ac4684471a08728e0c8122d97bc8182a80d09767f4e92a6f924e1a9609a"
        },
        "arm64": {
            "url": "https://github.com/GitTools/GitVersion/releases/download/7.0.0/gitversion-win-arm64-7.0.0.zip",
            "hash": "540daebc5ea3760da716137b5c84d0abc9cd9544554e22aab836de15d472bdc8"
        }
    },
    "extract_to": "app",
    "bin": "app\\gitversion.exe",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/GitTools/GitVersion"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/GitTools/GitVersion/releases/download/$version/gitversion-win-x64-$version.zip"
            },
            "arm64": {
                "url": "https://github.com/GitTools/GitVersion/releases/download/$version/gitversion-win-arm64-$version.zip"
            }
        }
    }
}
