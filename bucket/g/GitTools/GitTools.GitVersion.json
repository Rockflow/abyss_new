{
    "version": "7.0.1",
    "description": "一款可依据 Git 提交历史生成语义化版本号的工具 | A tool that generates a Semantic Version number based on your Git history",
    "homepage": "https://gitversion.net",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/GitTools/GitVersion/releases/download/7.0.1/gitversion-win-x64-7.0.1.zip",
            "hash": "cd36b85f02a47a96fe3399091dfb3e042e3a31b6db1a74adacd9372735278d51"
        },
        "arm64": {
            "url": "https://github.com/GitTools/GitVersion/releases/download/7.0.1/gitversion-win-arm64-7.0.1.zip",
            "hash": "47da643e283a556c816f9f9a90bf7de8c7b348140a951ff887797214d970475f"
        }
    },
    "extract_to": "app",
    "bin": "app\\gitversion.exe",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/GitTools/GitVersion"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/GitTools/GitVersion/releases/download/$version/gitversion-win-x64-$version.zip"
            },
            "arm64": {
                "url": "https://github.com/GitTools/GitVersion/releases/download/$version/gitversion-win-arm64-$version.zip"
            }
        }
    }
