    "link": "$env:AppData\\liren.project-graph",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/graphif/project-graph"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/graphif/project-graph/releases/download/v$version/Project.Graph_$version_x64-setup.exe"
