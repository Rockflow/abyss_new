{
    "version": "2.0.0",
    "description": "一款现代下载管理器，使用 Golang 和 Flutter 构建 | A modern download manager. Built with Golang and Flutter",
    "homepage": "https://gopeed.com",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/GopeedLab/gopeed/releases/download/v2.0.0/Gopeed-v2.0.0-windows-amd64-portable.zip",
            "hash": "c2849d59e4b71e088c9a92fc3538a742d7b8736cb431b64cd99d7d5284b8f285"
        }
    },
    "extract_to": "app",
    "bin": "app\\gopeed.exe",
    "shortcuts": [
        [
            "app\\gopeed.exe",
            "Gopeed"
        ]
    ],
    "persist": [
        [
            "app\\gopeed.db",
            "AppData\\Local\\Programs\\gopeed\\storage\\gopeed.db"
        ]
    ],
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/GopeedLab/gopeed"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/GopeedLab/gopeed/releases/download/v$version/Gopeed-v$version-windows-amd64-portable.zip"
            }
        }
    }
}
