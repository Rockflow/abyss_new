{
    "version": "2.0.7",
    "description": "一款类似 Typora 的文档编辑器，拥有更快的性能、智能 AI 辅助和 Git 集成 | A Typora-like document editor with faster performance, smart AI assistance, and Git integration",
    "homepage": "https://www.zditor.com",
    "license": {
        "identifier": "Unknown"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/zditor/zditor-docs/releases/download/zditor-v2.0.7/zditor_2.0.7_x64-setup.exe",
            "hash": "34612867c27ef7380f04371088697b02e763ec008f63e99fff6d7c0127ce3871"
        }
    },
    "shortcuts": [
        [
            "app\\zditor.exe",
            "zditor"
        ]
    ],
    "link": "$env:AppData\\com.zditor.ai",
    "cleanup": "$env:LocalAppData\\com.zditor.ai",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/zditor/zditor-docs",
        "regex": "zditor-v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zditor/zditor-docs/releases/download/zditor-v$version/zditor_$version_x64-setup.exe"
            }
        }
    }
}
