{
    "version": "0.45.23",
    "description": "极致优雅的开源 Markdown AI Agent | An extremely elegant open-source Markdown AI Agent",
    "homepage": "https://moraya.app",
    "license": {
        "identifier": "Apache-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/zouwei/moraya/releases/download/v0.45.23/Moraya_0.45.23_win_x64-setup.exe",
            "hash": "64a7530922d43c39647e94ae475ff8952d52aa806a43f65fab693c757327b6bc"
        }
    },
    "shortcuts": [
        [
            "app\\moraya.exe",
            "Moraya"
        ]
    ],
    "link": [
        "$env:AppData\\com.moraya.app",
        "$home\\.moraya"
    ],
    "cleanup": "$env:LocalAppData\\com.moraya.app",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/zouwei/moraya",
        "script": [
            "$a = ($page | ConvertFrom-Json).assets",
            "if ($a) { ($a | Where-Object { $_.name -match '^Moraya_[\\d.]+_win_x64-setup\\.exe$' } | Select-Object -First 1).browser_download_url }"
        ],
        "regex": "download/v([\\d.]+)/"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zouwei/moraya/releases/download/v$version/Moraya_$version_win_x64-setup.exe"
            }
        }
    }
}
