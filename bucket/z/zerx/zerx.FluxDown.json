    "architecture": {
        "64bit": {
            "url": "https://github.com/zerx-lab/FluxDown/releases/download/v0.6.6/FluxDown-0.6.6-windows-x64-setup.exe",
            "hash": "824ec7868d91d3a2fa6b3321711c12c64a9e1df6f41c146086c157eaa0a92041"
        },
        "arm64": {
            "url": "https://github.com/zerx-lab/FluxDown/releases/download/v0.6.6/FluxDown-0.6.6-windows-arm64-setup.exe",
