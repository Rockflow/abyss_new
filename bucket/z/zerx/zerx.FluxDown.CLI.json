{
    "version": "0.6.7",
    "description": "一款基于 Rust 开发的下载管理器，支持 HTTP、FTP、BitTorrent 以及 HLS/DASH 流媒体协议 | A Rust-powered download manager with HTTP, FTP, BitTorrent and HLS/DASH streaming support",
    "homepage": "https://fluxdown.zerx.dev",
    "license": {
        "identifier": "AGPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/zerx-lab/FluxDown/releases/download/v0.6.7/FluxDown-CLI-0.6.7-windows-x64.zip",
            "hash": "e9faa375d39a871dab0d2e0ebcef32f9828a527732ff30f7fcb99bc0ca784951",
            "extract_dir": "fluxdown-cli-0.6.7-windows-x64"
        },
        "arm64": {
            "url": "https://github.com/zerx-lab/FluxDown/releases/download/v0.6.7/FluxDown-CLI-0.6.7-windows-arm64.zip",
            "hash": "5b7bcdbc66784671c3fefa013c146bdfe235c26a2686e4036f4a34ce5d3d26e2",
            "extract_dir": "fluxdown-cli-0.6.7-windows-arm64"
        }
    },
    "extract_to": "app",
    "bin": "app\\fluxdown.exe",
    "link": "$env:AppData\\zerx\\fluxdown",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/zerx-lab/FluxDown",
        "script": [
            "$a = ($page | ConvertFrom-Json).assets",
            "if ($a) { ($a | Where-Object { $_.name -match '^FluxDown-CLI-[\\d.]+-windows-x64\\.zip$' } | Select-Object -First 1).browser_download_url }"
        ],
        "regex": "download/v(?<version>[\\d.]+)/FluxDown-CLI"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zerx-lab/FluxDown/releases/download/v$version/FluxDown-CLI-$version-windows-x64.zip",
                "extract_dir": "fluxdown-cli-$version-windows-x64"
            },
            "arm64": {
                "url": "https://github.com/zerx-lab/FluxDown/releases/download/v$version/FluxDown-CLI-$version-windows-arm64.zip",
                "extract_dir": "fluxdown-cli-$version-windows-arm64"
            }
        }
    }
}
