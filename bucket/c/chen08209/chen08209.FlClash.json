            "hash": "5754a11b5177fdddf9eee06b5059ed2bcbc467c7058d4ca25541d64b778bdc86"
        }
    },
    "shortcuts": [
        [
            "app\\FlClash.exe",
            "FlClash"
        ]
    ],
    "link": "$env:AppData\\com.follow\\clash",
    "cleanup": "$env:LocalAppData\\com.follow\\clash",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
