{
    "version": "1.9.36",
    "description": "Bash 在 cmd.exe 中强大的命令行编辑功能 | Powerful Bash-style command line editing for cmd.exe",
    "homepage": "https://chrisant996.github.io/clink",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "notes_cn": [
        "如果要在当前 cmd.exe 中启动 Clink，请运行 clink inject。",
        "如果要自动启动 Clink，请运行 clink autorun install。"
    ],
    "notes": [
        "Run 'clink inject' to start Clink on the current cmd.",
        "Run 'clink autorun install' to auto start Clink."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/chrisant996/clink/releases/download/v1.9.36/clink.1.9.36.af9152.zip",
            "hash": "1eb57b2511cdc6b97b002f198fea8596f28c445eaafa4507c2215a53261357c9"
        }
    },
    "extract_to": "app",
    "bin": "app\\clink.bat",
    "link": "$env:LocalAppData\\clink",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/chrisant996/clink",
        "script": "(($page | ConvertFrom-Json).assets | Where-Object { $_.name -match '^clink\\.[\\d.]+\\.[\\w.]+\\.zip$' })[0].browser_download_url",
        "regex": "clink\\.(?<version>[\\d.]+)\\.(?<commit>[\\w.]+)\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/chrisant996/clink/releases/download/v$version/clink.$version.$matchCommit.zip"
            }
        }
    }
}
