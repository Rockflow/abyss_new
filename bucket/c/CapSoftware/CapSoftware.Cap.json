    "license": {
        "identifier": "AGPL-3.0-or-later|MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://cap.so/download/windows#/dl.exe",
            "hash": "2b24ee786e65925138b141aff5b05fff3e375e92a91ab95be8d952e96d92f1ec"
        }
    },
    "shortcuts": [
        [
            "app\\Cap.exe",
            "Cap"
        ]
    ],
    "link": "$env:AppData\\so.cap.desktop",
    "cleanup": "$env:LocalAppData\\so.cap.desktop",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/CapSoftware/Cap",
        "regex": "cap-(.+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://cap.so/download/windows#/dl.exe"
            }
        }
    }
