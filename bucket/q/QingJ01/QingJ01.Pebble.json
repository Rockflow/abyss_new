{
    "version": "0.1.6",
    "description": "一款优先本地运行的桌面邮件客户端 | A local-first desktop email client",
    "homepage": "https://pebble.byebug.cn",
    "license": {
        "identifier": "AGPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/QingJ01/Pebble/releases/download/v0.1.6/Pebble_0.1.6_x64-setup.exe",
            "hash": "48ee751ab404aea505e6cfedb5c4f19b5d7147a1d338e46217c89ff54b4d84f9"
        }
    },
    "shortcuts": [
        [
            "app\\pebble.exe",
            "Pebble"
        ]
    ],
    "link": "$env:AppData\\com.qingj01.pebble",
    "cleanup": "$env:LocalAppData\\com.qingj01.pebble",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/QingJ01/Pebble"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/QingJ01/Pebble/releases/download/v$version/Pebble_$version_x64-setup.exe"
            }
        }
    }
}
