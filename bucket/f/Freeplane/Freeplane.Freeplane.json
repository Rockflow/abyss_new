{
    "version": "1.13.5",
    "description": "一款免费/自由开源软件，支持思维整理、信息共享以及工作学习与家庭事务的高效管理 | A free and open source software application that supports thinking, sharing information, getting things done at work, in school and at home",
    "homepage": "https://freeplane.org",
    "license": {
        "identifier": "GPL-2.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/freeplane/freeplane/releases/download/release-1.13.5/Freeplane-Setup-1.13.5.exe",
            "hash": "4261a47714ae3fcff1cf6ce33f4b186a10bc66baed605b60d167c598a0290816"
        }
    },
    "shortcuts": [
        [
            "app\\freeplane.exe",
            "Freeplane"
        ]
    ],
    "link": "$env:AppData\\Freeplane",
    "admin": true,
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-Inno"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-Inno"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/freeplane/freeplane",
        "regex": "release-(.+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/freeplane/freeplane/releases/download/release-$version/Freeplane-Setup-$version.exe"
            }
        }
    }
}
