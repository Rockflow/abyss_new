            "hash": "531feb63807da28ce42d8bae013e080829882c2a81365607063fe10741afbee0"
        },
        "arm64": {
            "url": "https://github.com/floatpane/matcha/releases/download/v1.4.1/matcha_1.4.1_windows_arm64.zip",
