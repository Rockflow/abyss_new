{
    "version": "15.0.0",
    "description": "功能强大且使用简单的屏幕截图软件 | Powerful yet simple to use screenshot software",
    "homepage": "https://flameshot.org",
    "license": {
        "identifier": "GPL-3.0-or-later"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/flameshot-org/flameshot/releases/download/v15.0.0/Flameshot-15.0.0-win64.msi",
            "hash": "69b8245ab4cb060e70716f493a7b2319e0421649d3e1b194a1b81503f3199a2d"
        }
    },
    "extract_dir": "Flameshot",
    "extract_to": "app",
    "bin": "app\\bin\\flameshot.exe",
    "shortcuts": [
        [
            "app\\bin\\flameshot.exe",
            "Flameshot"
        ]
    ],
    "link": "$env:AppData\\flameshot",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/flameshot-org/flameshot"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/flameshot-org/flameshot/releases/download/v$version/Flameshot-$version-win64.msi"
            }
        }
    }
}
