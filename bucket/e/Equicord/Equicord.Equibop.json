        "arm64": {
            "url": "https://github.com/Equicord/Equibop/releases/download/v3.3.4/Equibop-Setup-3.3.4.exe",
            "hash": "ab258ac882fda2661880b484e6c00317627362a45f1603a472dc576ed4d9a30f"
        }
    },
    "shortcuts": [
        [
            "app\\equibop.exe",
            "Equibop"
        ]
    ],
    "link": "$env:AppData\\equibop",
    "cleanup": "$env:LocalAppData\\equibop-updater",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\Uninstall Equibop.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/Equicord/Equibop"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Equicord/Equibop/releases/download/v$version/Equibop-Setup-$version.exe"
            },
            "arm64": {
                "url": "https://github.com/Equicord/Equibop/releases/download/v$version/Equibop-Setup-$version.exe"
            }
        }
    }
