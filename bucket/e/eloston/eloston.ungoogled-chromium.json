        "arm64": {
            "url": "https://github.com/ungoogled-software/ungoogled-chromium-windows/releases/download/158.0.8127.88-1.1/ungoogled-chromium_158.0.8127.88-1.1_installer_arm64.exe",
            "hash": "c5217eb10ae385389ebea4df1c9d92d93834981f823ba386cbc35a3a2fd57279"
