        "arm64": {
            "url": "https://github.com/ungoogled-software/ungoogled-chromium-windows/releases/download/156.0.8078.79-1.1/ungoogled-chromium_156.0.8078.79-1.1_installer_arm64.exe",
            "hash": "49115060ba4060e7047b3c3069bbf110556cef0414a94b1b1e9c4101367f535e"
