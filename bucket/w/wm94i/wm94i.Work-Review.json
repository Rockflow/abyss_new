{
    "version": "1.2.0",
    "description": "工作回顾与 AI 日报助手 | Work review and AI daily report assistant",
    "homepage": "https://github.com/wm94i/Work_Review",
    "license": {
        "identifier": "MIT"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/wm94i/Work_Review/releases/download/v1.2.0/Work_Review_1.2.0_x64-setup.exe",
            "hash": "484fff4897e21e4be9a9e434d7f28e9a8f486cd515b93e52cdec28a8cd8447f5"
        }
    },
    "shortcuts": [
        [
            "app\\Work_Review.exe",
            "Work Review"
        ]
    ],
    "link": "$env:AppData\\work-review",
    "cleanup": "$env:LocalAppData\\com.workreview.app",
    "pre_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Install",
        "A-Install-App -Uninstaller 'app\\uninstall.exe'"
    ],
    "post_install": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Install"
    ],
    "pre_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Start-Uninstall",
        "A-Stop-Process",
        "A-Remove-Link",
        "A-Uninstall-App"
    ],
    "post_uninstall": [
        "if (!$bucket) { $bucket = 'abyss' }",
        ". $bucketsdir\\$bucket\\util\\_.ps1",
        "A-Complete-Uninstall"
    ],
    "checkver": {
        "github": "https://github.com/wm94i/Work_Review"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/wm94i/Work_Review/releases/download/v$version/Work_Review_$version_x64-setup.exe"
            }
        }
    }
}
